# Archipelago Server UI: the worker (YAML checks, apworld import tests, generation). Installed
# by lxc/install.sh. It runs uploaded apworld code, so it has no network, an ephemeral user,
# and nothing writable but the job queue (DESIGN.md §2).
[Unit]
Description=Archipelago Server UI: worker
Documentation=https://github.com/TheReplenisher/archipelago-server-ui

[Service]
Type=exec
DynamicUser=yes
SupplementaryGroups=apsui-jobs
EnvironmentFile=/opt/apsui/install.env
Environment=APSUI_JOBS_DIR=/var/lib/apsui/jobs
Environment=APSUI_ARCHIPELAGO_DIR=/opt/archipelago
Environment=APSUI_BUILTIN_WORLDS=/opt/apsui/builtin-worlds.json
Environment=SKIP_REQUIREMENTS_UPDATE=1
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/archipelago-venv/bin/python -m apsui_worker.main --jobs-dir /var/lib/apsui/jobs
Restart=on-failure
RestartSec=5
UMask=0007
PrivateNetwork=yes
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/apsui/jobs
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=2G
CPUQuota=200%
TasksMax=512

[Install]
WantedBy=multi-user.target
