# Archipelago Server UI: the server service (supervises MultiServer, which players connect
# to). Installed by lxc/install.sh. MultiServer imports apworld code, so it sees only the
# game folder and /run/apsui, and no database or library (DESIGN.md §2).
[Unit]
Description=Archipelago Server UI: server
Documentation=https://github.com/TheReplenisher/archipelago-server-ui
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=apsui-server
Group=apsui-game
EnvironmentFile=/etc/apsui/apsui.env
EnvironmentFile=/opt/apsui/install.env
Environment=APSUI_GAME_DIR=/var/lib/apsui/game
Environment=APSUI_ARCHIPELAGO_DIR=/opt/archipelago
Environment=APSUI_BUILTIN_WORLDS=/opt/apsui/builtin-worlds.json
Environment=SKIP_REQUIREMENTS_UPDATE=1
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# The control and relay sockets; the web service reaches them through the apsui-game group.
RuntimeDirectory=apsui
RuntimeDirectoryMode=0770
ExecStart=/opt/archipelago-venv/bin/python -m apsui_server --port ${APSUI_GAME_PORT}
Restart=on-failure
RestartSec=5
# Stop saves the game first; give MultiServer the time the supervisor allows it.
TimeoutStopSec=60
UMask=0007
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/apsui/game
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=1G
TasksMax=256

[Install]
WantedBy=multi-user.target
